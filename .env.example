# 根目录集中配置（主配置源）— 复制为 .env
#
# 本项目支持「根目录集中配置」：在此文件配置的键，所有 Agent 默认继承。
# 各 Agent 目录下的 .env 只需放「想独立于根」的键；不写的键自动继承根（见各 Agent 文档）。
#
# LLM 配置（DeepSeek 官方）
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=${DEEPSEEK_API_KEY}
LLM_MODEL="deepseek-v4-flash"

# 可选：路径配置（默认全部自动推导到项目内标准位置，无需填写）
# STRATEGIES_DIR=""
# CRAWLER_SCRIPT=""
# DATA_DIR=""
# RAG_DIR=""
# NJU_BROWSER_DIR=""

# 可选：如需独立覆盖，在对应 Agent 目录的 .env 里写（根优先于缺失键，Agent 值覆盖根）
