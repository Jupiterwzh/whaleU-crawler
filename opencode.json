{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file:///mnt/c/Users/wangzhiheng/Desktop/superpowers-main/.opencode/plugins/superpowers.js"
  ],
  "skills": {
    "paths": ["./skills"]
  },
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "cherryin/deepseek/deepseek-v4-flash(free)",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/anthropic",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/anthropic",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek-V4-Flash"
        }
      }
    },
    "cherryin": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CherryIN",
      "options": {
        "baseURL": "https://open.cherryin.cc/v1",
        "apiKey": "{env:CHERRYIN_API_KEY}"
      },
      "models": {
        "openai/gpt-5.4": {
          "name": "GPT-5.4"
        },
        "openai/gpt-5.5": {
          "name": "GPT-5.5"
        },
        "deepseek/deepseek-v4-flash(free)": {
          "name": "DeepSeek V4 Flash Free"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls*": "allow",
      "rg*": "allow",
      "git status*": "allow",
      "node --check*": "allow",
      "npm test*": "allow",
      "npm run build*": "allow",
      "rm *": "deny",
      "git push --force*": "deny"
    },
    "webfetch": "allow"
  }
}