# LLM 配置（CherryIN deepseek）— 复制为 .env 并填入真实 key
LLM_BASE_URL=https://open.cherryin.cc/v1
LLM_API_KEY=your-key-here
LLM_MODEL=deepseek/deepseek-v4-flash(free)

# 路径配置（绝不硬编码，按你的实际路径填写）
STRATEGIES_DIR=<你的项目路径>/crawler/data/strategies
CRAWLER_SCRIPT=<你的项目路径>/crawler/src/collectors/collector.js
NJU_BROWSER_DIR=<你的 NJU 浏览器服务目录>
