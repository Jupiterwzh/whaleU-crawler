# LLM 配置（DeepSeek 官方）— 复制为 .env
# LLM_API_KEY 用 ${DEEPSEEK_API_KEY} 引用环境变量（需先设置 DEEPSEEK_API_KEY）
# main.py 启动时自动加载本文件（python-dotenv），无需手动 source
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=${DEEPSEEK_API_KEY}
LLM_MODEL="deepseek-v4-flash"

# 路径配置（绝不硬编码，按你的实际路径填写）
STRATEGIES_DIR="<你的项目路径>/crawler/data/strategies"
CRAWLER_SCRIPT="<你的项目路径>/crawler/src/collectors/collector.js"
NJU_BROWSER_DIR="<项目路径>/nju-browser"
