# LLM 配置（DeepSeek 官方）— 复制为 .env
# LLM_API_KEY 用 ${DEEPSEEK_API_KEY} 引用环境变量（需先设置 DEEPSEEK_API_KEY）
# main.py 启动时自动加载本文件（python-dotenv），无需手动 source
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=${DEEPSEEK_API_KEY}
LLM_MODEL="deepseek-v4-flash"

# 路径配置（可选，留空自动推导到项目内标准位置）：
# 不填时自动推导：STRATEGIES_DIR=<项目>/crawler/data/strategies；CRAWLER_SCRIPT=<项目>/crawler/src/collectors/collector.js
# 仅在非标准布局时才需要手动指定。
# STRATEGIES_DIR=""
# CRAWLER_SCRIPT=""
# DATA_DIR=""
